# Teleprompt Pro — SECRETS TEMPLATE (safe to commit; contains NO real values)
# =========================================================================
# Copy this file to `.env.local` and fill in real values there.
# `.env.local` is git-ignored and never leaves your machine.
# NEVER put real keys in this file — it is committed to a PUBLIC repo.
#
# Teleprompt Pro presently requires NO keys (keyless browser APIs only).
# These are documented slots for optional future features.
# =========================================================================

# Cloud speech-to-text (optional; higher accuracy than Chrome's built-in STT)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Built-in AI delivery-report analysis (Claude)
ANTHROPIC_API_KEY=

# GitHub automation (deploys normally use the `gh` CLI login instead)
GITHUB_TOKEN=
